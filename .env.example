# Database (use either DB_URL or individual fields)
DB_URL=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=inventory_db

# JWT
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=15m

# Session (secrets must be 32+ characters)
SESSION_SECRET=your_session_secret_min_32_chars_long
COOKIE_SECRET=your_cookie_secret_min_32_chars_long

# App
APP_DOMAIN=endfield.cydlab.my.id
NODE_ENV=development
PORT=3001
UI_URL=http://localhost:3000

# S3
S3_BUCKET=
S3_REGION=
S3_IAM_ROLE_ARN=

# AWS Credential
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CDN
CDN_URL=
